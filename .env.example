# ============================================================================
# REQUIRED to run the app locally and preview the dashboard.
# Defaults below work out of the box with `docker-compose up -d` (see README
# "Run locally" section) — no edits needed just to log in and click around.
# ============================================================================

# Local Postgres via docker-compose (docker-compose.yml). No pooler locally,
# so DATABASE_URL and DIRECT_URL are identical.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
# Dev-only value, fine to use as-is locally. Generate a real one for any
# deployed environment: `openssl rand -hex 32`.
NEXTAUTH_SECRET="local-dev-secret-do-not-use-in-production"

# Supabase staging only. Never expose the secret key to browser code.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# ============================================================================
# OPTIONAL — only needed for the features that call out to these services
# (Twilio SMS/voice, the Claude chatbot, campaign emails, contact form email,
# and the campaigns cron). The dashboard, login, leads, and campaigns UI all
# work without these; calls to the underlying integration are skipped and
# logged instead of failing when a var is missing.
# ============================================================================

# Twilio (HVAC business number — different from mortgage number)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
TECH_PERSONAL_PHONE="+1XXXXXXXXXX"

# Anthropic (SMS chatbot replies + lead-info extraction)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Email — contact form (Resend) and campaign sends (Gmail SMTP + App Password)
RESEND_API_KEY="re_xxxxxxxxxx"
CONTACT_EMAIL="hello@example.com"

# Retell. RETELL_API_KEY powers the "Talk to Maddie" live voice demo AND the
# dashboard call-log ingestion (backfill + webhook signature verification).
# Get it from the Retell dashboard -> API Keys. Same account/key for both.
RETELL_API_KEY="key_xxxxxxxxxx"
RETELL_DEMO_AGENT_ID="agent_xxxxxxxxxx"

GMAIL_USER="mannaflow.io@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
TECH_EMAIL="bravepanda.mf@gmail.com"
BOOKING_LINK="https://mannaflow-site.vercel.app/book-demo"

# Cron security — bearer token /api/cron/campaigns requires
CRON_SECRET="generate-with: openssl rand -hex 16"
