generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["contractor"]
}

enum ContractorPipelineStage {
  NEW_LEAD
  CONTACTED
  QUOTE_SENT
  JOB_BOOKED
  JOB_COMPLETE
  INVOICE_SENT
  PAID

  @@schema("contractor")
}

enum ContractorServiceType {
  REPAIR
  INSTALLATION
  MAINTENANCE
  EMERGENCY

  @@schema("contractor")
}

enum ContractorUrgencyLevel {
  ROUTINE
  URGENT
  EMERGENCY

  @@schema("contractor")
}

enum ContractorActivityType {
  CALL
  SMS
  EMAIL
  NOTE
  STAGE_CHANGE

  @@schema("contractor")
}

enum ContractorDirection {
  INBOUND
  OUTBOUND

  @@schema("contractor")
}

enum ContractorMessageRole {
  USER
  ASSISTANT

  @@schema("contractor")
}

enum ContractorCampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED

  @@schema("contractor")
}

enum ContractorUserRole {
  INTERNAL_ADMIN
  CLIENT_ADMIN
  CLIENT_MEMBER

  @@schema("contractor")
}

model ContractorOrganization {
  id            String   @id @default(uuid())
  name          String   @unique
  inboundPhone  String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users          ContractorTechUser[]
  leads          ContractorLead[]
  campaigns      ContractorCampaign[]
  activityLogs   ContractorActivityLog[]
  chatMessages   ContractorChatMessage[]
  followUpJobs   ContractorFollowUpJob[]
  campaignLeads  ContractorCampaignLead[]

  @@schema("contractor")
}

model ContractorLead {
  id               String             @id @default(uuid())
  name             String?
  organizationId   String
  phone            String
  email            String?
  address          String?
  issueDescription String?
  serviceType      ContractorServiceType?
  urgencyLevel     ContractorUrgencyLevel?
  leadSource       String             @default("Unknown")
  notes            String?
  currentStage     ContractorPipelineStage  @default(NEW_LEAD)
  dateEnteredStage DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  activityLogs ContractorActivityLog[]
  chatMessages ContractorChatMessage[]
  campaigns    ContractorCampaignLead[]
  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@schema("contractor")
}

model ContractorActivityLog {
  id        String           @id @default(uuid())
  leadId    String
  organizationId String
  type      ContractorActivityType
  direction ContractorDirection?
  content   String
  timestamp DateTime         @default(now())

  lead ContractorLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@schema("contractor")
}

model ContractorChatMessage {
  id        String          @id @default(uuid())
  leadId    String
  organizationId String
  role      ContractorMessageRole
  content   String
  escalated Boolean         @default(false)
  timestamp DateTime        @default(now())

  lead ContractorLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@schema("contractor")
}

model ContractorFollowUpJob {
  id          String   @id @default(uuid())
  leadId      String   @unique
  organizationId String
  phone       String
  scheduledAt DateTime
  sent        Boolean  @default(false)
  createdAt   DateTime @default(now())

  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@schema("contractor")
}

model ContractorTechUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  organizationId String
  role      ContractorUserRole @default(CLIENT_MEMBER)
  createdAt DateTime @default(now())

  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@schema("contractor")
}

model ContractorCampaign {
  id          String             @id @default(uuid())
  name        String
  organizationId String
  path        String?
  description String?
  status         ContractorCampaignStatus @default(ACTIVE)
  steps       Json               @default("[]")
  timezone    String             @default("UTC")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  leads ContractorCampaignLead[]
  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, path])
  @@index([organizationId])
  @@schema("contractor")
}

enum ContractorCampaignLeadStatus {
  ACTIVE
  STOPPED
  COMPLETED

  @@schema("contractor")
}

model ContractorCampaignLead {
  id                String                 @id @default(uuid())
  campaignId        String
  leadId            String
  organizationId    String
  assignedAt        DateTime               @default(now())
  status            ContractorCampaignLeadStatus @default(ACTIVE)
  lastStepIndexSent Int                    @default(-1)
  stoppedReason     String?
  stepOverrides     Json?

  campaign ContractorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     ContractorLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization ContractorOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([campaignId, leadId])
  @@index([organizationId])
  @@schema("contractor")
}
